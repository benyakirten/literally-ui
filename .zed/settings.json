{
  "lsp": {
    "vtsls": {
      "settings": {
        "vtsls": {
          "tsserver": {
            "globalPlugins": [
              {
                "name": "ts-lit-plugin",
                "languages": ["javascript", "typescript"],
                "enableForWorkspaceTypeScriptVersions": true,
              },
            ],
          },
        },
        "typescript": {
          "tsserver": {
            "pluginPaths": ["./node_modules"],
          },
        },
      },
    },
  },
}
