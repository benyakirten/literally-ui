{
  "lsp": {
    "vtsls": {
      "settings": {
        "vtsls": {
          "tsserver": {
            "globalPlugins": [
              {
                "name": "ts-lit-plugin",
                "languages": ["javascript", "typescript"],
                "enableForWorkspaceTypeScriptVersions": true,
              },
            ],
          },
        },
        "typescript": {
          "tsserver": {
            "pluginPaths": ["./node_modules"],
          },
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["oxc", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt",
        },
      },
      "format_on_save": "on",
    },
    "TypeScript": {
      "language_servers": ["oxc", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt",
        },
      },
      "format_on_save": "on",
    },
    "TSX": {
      "language_servers": ["oxc", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt",
        },
      },
      "format_on_save": "on",
    },
  },
}
